# All optional. Copy to .env to use.

# --- literature sources -----------------------------------------------------
# BDR_CONTACT_EMAIL=you@example.org   # sent to NCBI and OpenAlex as the polite-use contact
# NCBI_API_KEY=                        # raises the PubMed limit from 3 to 10 requests/second
# OPENALEX_API_KEY=

# --- model engine -----------------------------------------------------------
# By default the app uses Claude through your Claude Code login; no key needed.
# BDR_MODEL=claude-opus-5-5
# BDR_EFFORT_QUICK=medium              # low | medium | high | xhigh | max (Claude only)
# BDR_EFFORT_DEEP=high

# To use another provider instead, point at its Anthropic-compatible endpoint.
# Setting BDR_BASE_URL also disables the Claude-only request options above.
#
# Kimi (Moonshot):
# BDR_BASE_URL=https://api.moonshot.ai/anthropic
# BDR_MODEL=kimi-k3[1m]
# BDR_AUTH_TOKEN=sk-...
#
# GLM (Z.ai):
# BDR_BASE_URL=https://api.z.ai/api/anthropic
# BDR_MODEL=glm-5.2
# BDR_AUTH_TOKEN=...
#
# OpenRouter (one key, ~460 models from many providers):
# BDR_BASE_URL=https://openrouter.ai/api
# BDR_MODEL=z-ai/glm-5.3            # or moonshotai/kimi-k3, anthropic/claude-sonnet-5.5, ...
# BDR_AUTH_TOKEN=sk-or-...          # your OpenRouter key
#
# A provider with no Anthropic-compatible endpoint needs a translation proxy in front of
# it; set BDR_BASE_URL to the proxy's Anthropic-compatible address.

# --- server -----------------------------------------------------------------
# BDR_PORT=8790
